<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        画刷和控件样式单独成文件，App.xaml 和测试工程都合并这一份。
        测试自建 Application、不会跑 App.xaml，主题内联在 App.xaml 里时挂件窗口根本建不起来。
    -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F7F4EE"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFCF8"/>
    <SolidColorBrush x:Key="Ink" Color="#2B2925"/>
    <SolidColorBrush x:Key="MutedInk" Color="#817B70"/>
    <SolidColorBrush x:Key="Accent" Color="#B44837"/>
    <SolidColorBrush x:Key="Weekend" Color="#9B4B3F"/>
    <SolidColorBrush x:Key="Workday" Color="#C87A2B"/>
    <SolidColorBrush x:Key="Border" Color="#E7E0D5"/>
    <SolidColorBrush x:Key="TodayBackground" Color="#F1E8DD"/>
    <SolidColorBrush x:Key="WidgetSurface" Color="#DDF7F4EE"/>
    <SolidColorBrush x:Key="WidgetSurfaceBorder" Color="#C7FFFFFF"/>
    <SolidColorBrush x:Key="CalendarCellBackground" Color="#42FFFFFF"/>
    <SolidColorBrush x:Key="WidgetMutedInk" Color="#4F4B45"/>
    <SolidColorBrush x:Key="WidgetAccent" Color="#913526"/>
    <SolidColorBrush x:Key="WidgetWeekend" Color="#81382F"/>
    <SolidColorBrush x:Key="WidgetWorkday" Color="#844313"/>
    <DropShadowEffect x:Key="TextShadow" Color="#99000000" BlurRadius="2.5" Direction="270" ShadowDepth="1" Opacity="0.78"/>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
