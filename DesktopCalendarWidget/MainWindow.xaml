<Window x:Class="DesktopCalendarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopCalendarWidget"
        xmlns:local="clr-namespace:DesktopCalendarWidget"
        Width="640" Height="820" MinWidth="560" MinHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResize" Topmost="False" Icon="/Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="{x:Static loc:Loc.AppTitle}">
    <Border x:Name="Chrome" Margin="10" Padding="16" Background="{StaticResource WidgetSurface}" BorderBrush="{StaticResource WidgetSurfaceBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 半透明衬底透出桌面，天气粒子与闪光叠在衬底上、文字后方。 -->
            <Grid x:Name="WeatherSceneLayer" Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
                <Canvas x:Name="WeatherParticles" Opacity="0.84"/>
                <Rectangle x:Name="WeatherFlash" Stretch="Fill" Fill="White" Opacity="0"/>
            </Grid>
            <!--
                日历和抽屉并排放在同一行：抽屉列宽为 0 时窗口不占它，展开时 MainWindow 把窗口
                一起变宽并在右侧插入这一列，所以日历本身的位置和尺寸始终不变。
            -->
            <Grid x:Name="SplitGrid" Grid.RowSpan="4" Background="Transparent">
                <!-- 列宽由代码按「列号」分配：抽屉翻到左边时它在第 0 列，此时日历在第 1 列。
                     宽度若绑在 CalendarColumn 这个名字上，翻边后就会补给到抽屉那一列，把日历挤扁。 -->
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                <Grid x:Name="CalendarHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="MonthTitle" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Effect="{StaticResource TextShadow}"/>
                            <TextBlock x:Name="TodaySummary" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource WidgetMutedInk}" Effect="{StaticResource TextShadow}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="TodayButton" Style="{StaticResource WidgetButton}" Content="{x:Static loc:Loc.TodayButton}" Click="TodayButton_Click" Margin="0,2,2,0" Padding="10,6" Effect="{StaticResource TextShadow}"/>
                            <Button Style="{StaticResource IconButton}" Content="⋯" FontSize="22" Click="MenuButton_Click" ToolTip="{x:Static loc:Loc.MenuButtonTip}" Effect="{StaticResource TextShadow}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,8" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Content="‹" FontSize="26" Click="PreviousButton_Click" ToolTip="{x:Static loc:Loc.PreviousMonthTip}" Effect="{StaticResource TextShadow}"/>
                        <TextBlock x:Name="MonthCaption" Grid.Column="1" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource WidgetMutedInk}" Effect="{StaticResource TextShadow}"/>
                        <Button Style="{StaticResource IconButton}" Grid.Column="2" Content="›" FontSize="26" HorizontalAlignment="Right" Click="NextButton_Click" ToolTip="{x:Static loc:Loc.NextMonthTip}" Effect="{StaticResource TextShadow}"/>
                    </Grid>
                    <Grid x:Name="CalendarGrid" Grid.Row="2"/>
                    <!--
                        高度写死，不跟着内容走。上面 CalendarGrid 是星号宽高、这一块原本是 Auto，
                        于是底部区域的空态/列表态高度差被日历整块吸收：打开抽屉时底部区域会重绑到
                        抽屉那天的日期，有日程和没日程高度不同，日历就跟着跳一下。
                        固定高度后日历尺寸只由窗口大小决定，底部区域内部自己滚动。

                        150px 时日历格子每行只剩 69px，而一格要放日期号、天气、课程摘要、
                        农历和节日名五层，压完字号仍要 89px，节日名会溢出到相邻行。
                        收到 112px 后每行 75px，装得下。
                    -->
                    <Grid x:Name="BottomPanelHost" Grid.Row="3" Height="112" Margin="0,10,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Height="1" Background="{StaticResource Border}"/>
                        <local:DayAgendaPanel x:Name="BottomPanel" Grid.Row="1" Margin="0,8,0,0"/>
                        <TextBlock x:Name="Legend" Grid.Row="2" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource WidgetMutedInk}" Effect="{StaticResource TextShadow}"/>
                    </Grid>
                </Grid>
                <!-- 抽屉本体靠 RenderTransform 滑入，不参与列宽动画，免得每次开合都重排日历。 -->
                <Border x:Name="Drawer" Grid.Column="1" Background="#14FFFFFF" BorderBrush="{StaticResource Border}"
                        BorderThickness="{Binding DrawerBorderThickness, ElementName=Drawer}" Padding="14,16,14,16" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="drawerTransform"/>
                    </Border.RenderTransform>
                    <local:DayAgendaPanel x:Name="DrawerPanel"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
