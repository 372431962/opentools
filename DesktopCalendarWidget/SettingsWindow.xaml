<Window x:Class="DesktopCalendarWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="720" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Title="日历设置" Background="#FFFCF8">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="日历设置" FontSize="23" FontWeight="SemiBold" Foreground="#2B2925"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,12">
            <StackPanel>
                <TextBlock Text="显示" FontWeight="SemiBold" Foreground="#2B2925"/>
                <CheckBox x:Name="ShowLunarCheck" Content="显示农历" Margin="0,10,0,0"/>
                <CheckBox x:Name="ShowHolidayCheck" Content="显示节假日名称和调休“班”字" Margin="0,8,0,0"/>
                <TextBlock Text="关闭文字仍按节假日、调休计算休息与上班，并调整后续大小周。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>

                <TextBlock Text="休息日" FontWeight="SemiBold" Margin="0,22,0,0" Foreground="#2B2925"/>
                <TextBlock Text="休息日模式" Margin="0,10,0,6" Foreground="#817B70"/>
                <ComboBox x:Name="RestPatternCombo" Width="240" HorizontalAlignment="Left" SelectionChanged="RestPatternCombo_SelectionChanged">
                    <ComboBoxItem Content="不标记（周末按周六周日显示）"/>
                    <ComboBoxItem Content="每周单休"/>
                    <ComboBoxItem Content="隔周单休（大小周）"/>
                </ComboBox>
                <TextBlock Text="单休日" Margin="0,12,0,6" Foreground="#817B70"/>
                <ComboBox x:Name="SingleRestCombo" Width="240" HorizontalAlignment="Left" SelectionChanged="SingleRestCombo_SelectionChanged">
                    <ComboBoxItem Content="周六"/>
                    <ComboBoxItem Content="周日"/>
                </ComboBox>
                <StackPanel x:Name="AlternatePanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <CheckBox x:Name="AnchorSingleCheck" Content="本周是单休周" Click="AnchorSingleCheck_Click"/>
                    <TextBlock x:Name="AnchorWeekText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#817B70"/>
                    <TextBlock Text="单休周休所选单休日；双休周休周六、周日。周末调休后休1天，下周双休；休2天，下周单休，并继续交替。周末无休则按原计划翻转，周中放假不改变交替。更改本周选择会以本周为新基准，法定调休仍优先；仅改其他选项会保留原基准。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>
                </StackPanel>

                <TextBlock Text="窗口" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <CheckBox x:Name="LockCheck" Content="锁定位置" Margin="0,10,0,0"/>
                <CheckBox x:Name="ClickThroughCheck" Content="鼠标穿透（开启后无法拖动和右键操作）" Margin="0,8,0,0"/>
                <CheckBox x:Name="StartWithWindowsCheck" Content="随 Windows 启动" Margin="0,8,0,0"/>
                <TextBlock Text="透明度" Margin="0,16,0,6" Foreground="#817B70"/>
                <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Text="快捷键：Ctrl+Alt+C 切换鼠标穿透，Ctrl+Alt+L 切换位置锁定" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#817B70"/>

                <TextBlock Text="联网更新" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <TextBlock Text="手动从公开接口获取当前年和下一年的节假日，成功后保存到本地；失败时继续使用本地数据。" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#817B70"/>
                <TextBlock Text="更新地址（{0} 为年份）" Margin="0,0,0,6" Foreground="#817B70"/>
                <TextBox x:Name="UpdateUrlBox" FontFamily="Consolas"/>
                <Button x:Name="UpdateButton" Content="↻ 立即检查节假日更新" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,7" Click="UpdateButton_Click"/>
                <TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" Foreground="#817B70" TextWrapping="Wrap"/>

                <TextBlock Text="本地数据编辑" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <TextBlock Text="每行一个 JSON 对象，例如：{&quot;Date&quot;:&quot;2026-10-01&quot;,&quot;Name&quot;:&quot;国庆节&quot;,&quot;IsWorkday&quot;:false}" TextWrapping="Wrap" Margin="0,8,0,6" Foreground="#817B70"/>
                <TextBox x:Name="HolidayJsonBox" Height="120" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" LostFocus="HolidayJsonBox_LostFocus"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存本地节假日数据" Padding="12,7" Click="SaveHolidayButton_Click"/>
                    <Button Content="打开数据目录" Margin="8,0,0,0" Padding="12,7" Click="OpenDataFolderButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="14,8" Click="CancelButton_Click"/>
            <Button Content="保存" Padding="14,8" Margin="8,0,0,0" Background="#B44837" Foreground="White" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
