<Window x:Class="DesktopCalendarWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopCalendarWidget"
        Width="560" Height="720" MinWidth="480" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Title="{x:Static loc:Loc.SettingsTitle}" Background="#FFFCF8">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{x:Static loc:Loc.SettingsTitle}" FontSize="23" FontWeight="SemiBold" Foreground="#2B2925"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.SectionLanguage}" FontWeight="SemiBold" Foreground="#2B2925"/>
                <ComboBox x:Name="LanguageCombo" MinWidth="240" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                <TextBlock Text="{x:Static loc:Loc.LanguageNote}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>

                <TextBlock Text="{x:Static loc:Loc.SectionDisplay}" FontWeight="SemiBold" Margin="0,22,0,0" Foreground="#2B2925"/>
                <CheckBox x:Name="ShowLunarCheck" Content="{x:Static loc:Loc.ShowLunarCheck}" Margin="0,10,0,0"/>
                <CheckBox x:Name="ShowHolidayCheck" Content="{x:Static loc:Loc.ShowHolidayCheck}" Margin="0,8,0,0"/>
                <TextBlock Text="{x:Static loc:Loc.DisplayHideNote}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>
                <TextBlock x:Name="ChineseOnlyNote" Text="{x:Static loc:Loc.ChineseOnlyNote}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="#817B70" Visibility="Collapsed"/>

                <TextBlock Text="{x:Static loc:Loc.SectionWeather}" FontWeight="SemiBold" Margin="0,22,0,0" Foreground="#2B2925"/>
                <CheckBox x:Name="ShowWeatherCheck" Content="{x:Static loc:Loc.WeatherCheck}" Margin="0,10,0,0"/>
                <TextBlock Text="{x:Static loc:Loc.WeatherCityLabel}" Margin="0,12,0,6" Foreground="#817B70"/>
                <TextBox x:Name="WeatherCityBox" MinWidth="240" HorizontalAlignment="Left"/>
                <TextBlock Text="{x:Static loc:Loc.WeatherRefreshLabel}" Margin="0,12,0,6" Foreground="#817B70"/>
                <ComboBox x:Name="WeatherRefreshCombo" MinWidth="240" HorizontalAlignment="Left"/>
                <Button x:Name="WeatherUpdateButton" Content="{x:Static loc:Loc.WeatherUpdateButton}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Padding="12,7" Click="WeatherUpdateButton_Click"/>
                <TextBlock x:Name="WeatherStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#817B70"/>
                <TextBlock Text="{x:Static loc:Loc.WeatherRangeNote}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#817B70"/>
                <TextBlock Text="{x:Static loc:Loc.WeatherPrivacyNote}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>

                <TextBlock Text="{x:Static loc:Loc.SectionRestDays}" FontWeight="SemiBold" Margin="0,22,0,0" Foreground="#2B2925"/>
                <TextBlock Text="{x:Static loc:Loc.RestPatternLabel}" Margin="0,10,0,6" Foreground="#817B70"/>
                <ComboBox x:Name="RestPatternCombo" MinWidth="240" HorizontalAlignment="Left" SelectionChanged="RestPatternCombo_SelectionChanged">
                    <ComboBoxItem Content="{x:Static loc:Loc.PatternNone}"/>
                    <ComboBoxItem Content="{x:Static loc:Loc.PatternWeekly}"/>
                    <ComboBoxItem Content="{x:Static loc:Loc.PatternAlternate}"/>
                </ComboBox>
                <TextBlock Text="{x:Static loc:Loc.SingleRestLabel}" Margin="0,12,0,6" Foreground="#817B70"/>
                <ComboBox x:Name="SingleRestCombo" MinWidth="240" HorizontalAlignment="Left" SelectionChanged="SingleRestCombo_SelectionChanged">
                    <ComboBoxItem Content="{x:Static loc:Loc.DaySaturday}"/>
                    <ComboBoxItem Content="{x:Static loc:Loc.DaySunday}"/>
                </ComboBox>
                <StackPanel x:Name="AlternatePanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <CheckBox x:Name="AnchorSingleCheck" Content="{x:Static loc:Loc.AnchorSingleThisWeek}" Click="AnchorSingleCheck_Click"/>
                    <TextBlock x:Name="AnchorWeekText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#817B70"/>
                    <TextBlock Text="{x:Static loc:Loc.AlternateExplainer}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>
                </StackPanel>

                <TextBlock Text="{x:Static loc:Loc.SectionWindow}" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <CheckBox x:Name="LockCheck" Content="{x:Static loc:Loc.LockCheck}" Margin="0,10,0,0"/>
                <CheckBox x:Name="ClickThroughCheck" Content="{x:Static loc:Loc.ClickThroughCheck}" Margin="0,8,0,0"/>
                <CheckBox x:Name="StartWithWindowsCheck" Content="{x:Static loc:Loc.StartWithWindowsCheck}" Margin="0,8,0,0"/>
                <TextBlock Text="{x:Static loc:Loc.HotkeyNote}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#817B70"/>

                <TextBlock Text="{x:Static loc:Loc.SectionTranslate}" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <TextBlock Text="{x:Static loc:Loc.TranslateExplainer}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#817B70"/>
                <TextBlock Text="{x:Static loc:Loc.TranslateProviderLabel}" Margin="0,0,0,6" Foreground="#817B70"/>
                <ComboBox x:Name="TranslateProviderCombo" MinWidth="320" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{x:Static loc:Loc.TranslateProviderAuto}"/>
                    <ComboBoxItem Content="{x:Static loc:Loc.TranslateProviderMyMemory}"/>
                    <ComboBoxItem Content="{x:Static loc:Loc.TranslateProviderGoogle}"/>
                    <ComboBoxItem Content="{x:Static loc:Loc.TranslateProviderOffline}"/>
                </ComboBox>
                <CheckBox x:Name="TranslateOfflineFallbackCheck" Content="{x:Static loc:Loc.TranslateOfflineFallbackCheck}" Margin="0,10,0,0"/>
                <TextBlock Text="{x:Static loc:Loc.TranslatePrivacyNote}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#817B70"/>

                <TextBlock Text="{x:Static loc:Loc.SectionOnline}" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <TextBlock Text="{x:Static loc:Loc.OnlineExplainer}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#817B70"/>
                <TextBlock Text="{x:Static loc:Loc.UpdateUrlLabel}" Margin="0,0,0,6" Foreground="#817B70"/>
                <TextBox x:Name="UpdateUrlBox" FontFamily="Consolas"/>
                <Button x:Name="UpdateButton" Content="{x:Static loc:Loc.UpdateButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,7" Click="UpdateButton_Click"/>
                <TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" Foreground="#817B70" TextWrapping="Wrap"/>

                <TextBlock Text="{x:Static loc:Loc.SectionUpdate}" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <TextBlock x:Name="UpdateVersionText" Margin="0,8,0,0" Foreground="#817B70"/>
                <CheckBox x:Name="AutoCheckUpdatesCheck" Content="{x:Static loc:Loc.AutoCheckUpdatesCheck}" Margin="0,8,0,0"/>
                <Button x:Name="CheckUpdateButton" Content="{x:Static loc:Loc.CheckUpdateButton}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Padding="12,7" Click="CheckUpdateButton_Click"/>
                <TextBlock x:Name="CheckUpdateStatus" Margin="0,8,0,0" Foreground="#817B70" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Static loc:Loc.UpdatePrivacyNote}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#817B70"/>

                <TextBlock Text="{x:Static loc:Loc.SectionLocalData}" FontWeight="SemiBold" Margin="0,24,0,0" Foreground="#2B2925"/>
                <TextBlock Text="{x:Static loc:Loc.LocalDataHint}" TextWrapping="Wrap" Margin="0,8,0,6" Foreground="#817B70"/>
                <TextBox x:Name="HolidayJsonBox" Height="120" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" LostFocus="HolidayJsonBox_LostFocus"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{x:Static loc:Loc.SaveLocalButton}" Padding="12,7" Click="SaveHolidayButton_Click"/>
                    <Button Content="{x:Static loc:Loc.OpenFolderButton}" Margin="8,0,0,0" Padding="12,7" Click="OpenDataFolderButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Loc.CancelButton}" Padding="14,8" Click="CancelButton_Click"/>
            <Button Content="{x:Static loc:Loc.SaveButton}" Padding="14,8" Margin="8,0,0,0" Background="#B44837" Foreground="White" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
