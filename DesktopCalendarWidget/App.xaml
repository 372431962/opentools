<Application x:Class="DesktopCalendarWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F7F4EE"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFCF8"/>
        <SolidColorBrush x:Key="Ink" Color="#2B2925"/>
        <SolidColorBrush x:Key="MutedInk" Color="#817B70"/>
        <SolidColorBrush x:Key="Accent" Color="#B44837"/>
        <SolidColorBrush x:Key="Weekend" Color="#9B4B3F"/>
        <SolidColorBrush x:Key="Workday" Color="#C87A2B"/>
        <SolidColorBrush x:Key="Border" Color="#E7E0D5"/>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
