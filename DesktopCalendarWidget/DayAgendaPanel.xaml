<UserControl x:Class="DesktopCalendarWidget.DayAgendaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopCalendarWidget"
             Background="Transparent">
    <!--
        同一个控件承担两种形态：收起态贴在日历下方当一条可滚动的当日摘要，展开态成为右侧抽屉。
        标题里的「关闭」只在展开态出现；两种形态共用同一份渲染逻辑，不存在两套列表代码。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            标题分两列：左边是星号宽的日期文字（会截断），右边是固定宽的按钮。
            原来两者是同一个 Grid 里叠放的两个子元素，日期一长（英文界面尤其明显）就把
            右边的按钮挤出内容区被裁掉，关闭按钮因此消失。
        -->
        <Grid x:Name="Header" Margin="0,0,0,6" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                <TextBlock x:Name="DateText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"
                           Effect="{StaticResource TextShadow}"/>
                <TextBlock x:Name="CountText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource WidgetMutedInk}"
                           Effect="{StaticResource TextShadow}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AddButton" Content="+" Padding="9,3" Click="AddButton_Click"
                        ToolTip="{x:Static loc:Loc.ScheduleAddButton}" Effect="{StaticResource TextShadow}"/>
                <!--
                    关闭按钮原来只是一个裸的「✕」字符。全局 Button 样式给了透明背景和零边框，
                    挂在半透明挂件上几乎看不见，等于没有关闭入口。这里补上边框和底色，
                    让它一眼就是个能按的按钮。
                -->
                <Button x:Name="CloseButton" Content="✕" Padding="8,2" Margin="6,0,0,0" Visibility="Collapsed"
                        Click="CloseButton_Click" ToolTip="{x:Static loc:Loc.ScheduleCloseButton}"
                        Background="#40FFFFFF" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Top"
                       Foreground="{StaticResource WidgetMutedInk}" Effect="{StaticResource TextShadow}"/>
            <!-- 收起态只露出两三行，展开态占满抽屉高度；同一个 ScrollViewer 两种高度都能滚。 -->
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemList">
                    <!--
                        竖排列表而不是 WrapPanel：卡片要能撑满可用宽度，标题才会按真实宽度截断。
                        WrapPanel 给每个子元素它的期望宽度，MaxWidth 只能写死一个猜出来的数，
                        而抽屉宽度是用户可调的 200–420，写死就会在窄抽屉里溢出。
                    -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="8,5" CornerRadius="5" Background="#26FFFFFF"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- 细边框用类型自己的颜色，扫一眼就能分清课程和会议。 -->
                                        <Setter Property="BorderBrush" Value="{Binding Color}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#B44837"/>
                                                <Setter Property="Background" Value="#33B44837"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" Margin="5,0,0,0"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <!-- 类型名跟着界面语言走，不要在界面上暴露枚举标识符。 -->
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                   Foreground="{Binding Color}"/>
                                        <TextBlock Text="{Binding Time}" FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{StaticResource WidgetMutedInk}"/>
                                        <TextBlock Text="{Binding Place}" FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{StaticResource WidgetMutedInk}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
